      "query": "source={{index}} | rex field=email \"(?<user_name>[^@]+)@(?<domain>.+)\" | fields email"
    },
    "rex-capture-name-hyphen": {
      "role": "trigger",
      "query": "source={{index}} | rex field=email \"(?<user-name>[^@]+)@(?<domain>.+)\" | fields email"
    },
    "rex-capture-name-alphanumeric-control": {
      "role": "control",
      "query": "source={{index}} | rex field=email \"(?<username>[^@]+)@(?<domain>.+)\" | fields email, username, domain | head 1"
    }
  },
